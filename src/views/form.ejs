<%- include("partials/head") %>

<form method="POST" action="/new" class="max-w-md mx-auto mt-16 p-6 bg-white rounded-xl shadow flex flex-col gap-4">
    <header>
        <h1 class="text-2xl font-semibold text-gray-900">New Message</h1>
    </header>
    <input type="text" name="authorName" placeholder="Your name" class="border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
    <textarea name="messageText" placeholder="Your message" rows="4" class="border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
    <button type="submit" class="bg-blue-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-blue-700">Submit Message</button>
</form>
