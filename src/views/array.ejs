<div class="max-w-md mx-auto flex flex-col gap-3">
    <% globalMessages.forEach((message) => { %>
        <div key="message.id" class="bg-white rounded-xl shadow p-4 flex flex-col gap-1">
            <h3 class="font-semibold text-gray-900"><%= message.user %></h3>
            <p class="text-gray-700"><%= message.text %></p>
            <div class="flex items-center justify-between">
                <a href="/messages/<%= message.id %>" class="text-sm text-blue-600 hover:underline">Open</a>
                <p class="text-xs text-gray-400"><%= message.added %></p>
            </div>
        </div>
     <% }) %>
</div>